{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finland-experience-platform",
  "main": "custom-worker.ts",
  "compatibility_date": "2025-03-25",
  "previews": {},
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "vars": {
    "SUPABASE_URL": "https://pxazouraakldvwbswwtg.supabase.co",
    "NEXT_PUBLIC_SUPABASE_URL": "https://pxazouraakldvwbswwtg.supabase.co"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "finland-experience-platform"
    }
  ],
  "triggers": {
    "crons": ["0 */6 * * *"]
  }
}
