{
  "name": "finland-experience-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Multilingual Finnish travel destination marketplace and concierge platform (FI/ES/EN)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:i18n && node --import tsx --test --test-reporter=spec src/__tests__/domain/availability.test.ts src/__tests__/lib/rate-limit.test.ts src/__tests__/lib/utils.test.ts src/__tests__/lib/salo.test.ts",
    "test:watch": "node --import tsx --test --watch src/__tests__/domain/availability.test.ts src/__tests__/lib/rate-limit.test.ts src/__tests__/lib/utils.test.ts",
    "db:push": "npx --yes supabase@1.226.4 db push",
    "db:reset": "npx --yes supabase@1.226.4 db reset",
    "test:i18n": "node scripts/check-i18n.mjs",
    "build:cloudflare": "opennextjs-cloudflare build"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "clsx": "^2.1.1",
    "swr": "^2.1.3",
    "@supabase/supabase-js": "^2.114.0",
    "@supabase/ssr": "^0.12.7",
    "lucide-react": "^0.400.0",
    "next-intl": "4.14.9",
    "framer-motion": "^11.3.0",
    "tailwind-merge": "^2.4.0",
    "sonner": "^1.5.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.5.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.4.0",
    "@types/leaflet": "^1.9.20",
    "@opennextjs/cloudflare": "1.20.13"
  },
  "eslintConfig": {
    "extends": [
      "next/core-web-vitals"
    ],
    "rules": {
      "@next/next/no-html-link-for-pages": "off",
      "react/no-unescaped-entities": "off",
      "@next/next/no-sync-scripts": "off"
    }
  }
}
