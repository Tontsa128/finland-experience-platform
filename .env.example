# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy alias also supported by the app
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional server-only alias accepted by the backend
SUPABASE_URL=https://your-project.supabase.co

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: set true only for local/demo environments to show bundled fallback content.
NEXT_PUBLIC_ALLOW_DEMO_FALLBACK=false

# OpenAI
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5.6-luna
OPENAI_ADVISOR_MODEL=

# Contact email (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
